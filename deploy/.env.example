# Copy to deploy/.env (git-ignored, mode 600). Read by docker compose. No LLM keys here: every user saves their
# own under Settings -> My keys. Never commit deploy/.env.

# Fernet key that encrypts users' keys (api and worker need the same value; losing it loses the saved keys).
# Windows: scripts\windows\setup.ps1 writes this file with fresh values (docs/deployment-windows.md).
# Generate: docker run --rm python:3.12-slim sh -c "pip -q install cryptography && python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'"
#       or: python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
RESEARCH_SECRETS_KEY=

# PostgreSQL password (long random value, e.g. `openssl rand -hex 24`). The URL is built from it in compose.
DB_PASSWORD=

# First admin, created on the first start only (ignored once an admin exists). Clear the password afterwards.
RESEARCH_WEB_ADMIN_EMAIL=
RESEARCH_WEB_ADMIN_PASSWORD=

# Email domains allowed to sign up, comma separated (e.g. example.org,lab.example.org). Empty: signup off.
# Set once on first start; change later in Settings (admin).
RESEARCH_WEB_SIGNUP_DOMAINS=

# Contact address sent to polite API pools (OpenAlex, Crossref, Unpaywall).
RESEARCH_WEB_CONTACT_EMAIL=

# Host names / IPs the browser uses, comma separated (e.g. research.lan, 192.168.1.20).
SITE_ADDRESS=
# "internal" (Caddy's local CA) or "/certs/cert.pem /certs/key.pem" (files in deploy/certs/).
CADDY_TLS=internal
# Published ports on the host (only the proxy publishes any).
HTTPS_PORT=443
HTTP_PORT=80

# Outbound proxy for the worker, if the network needs one (empty: direct).
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=

# Optional host paths for eval folders and gold files (default: named volumes).
# EVALS_DIR=
# GOLD_DIR=

# Subnet of the Caddy <-> API network (the API trusts X-Forwarded-For only from it). Change if it clashes.
# EDGE_SUBNET=172.31.250.0/24
# Memory limits (on Docker Desktop they must fit in the WSL 2 VM's memory).
# API_MEMORY=1g
# WORKER_MEMORY=2g
